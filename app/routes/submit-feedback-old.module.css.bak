.container {
  max-width: 600px;
  margin: 0 auto;
  padding: var(--space-6);
}

.formWrapper {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

.title {
  font-family: var(--font-heading);
  font-size: 2rem;
  font-weight: 700;
  color: var(--color-neutral-12);
  margin: 0;
}

.counter {
  font-family: var(--font-body);
  font-size: 1rem;
  color: var(--color-accent-11);
  font-weight: 500;
  padding: var(--space-3) var(--space-4);
  background: var(--color-accent-3);
  border: 1px solid var(--color-accent-6);
  border-radius: var(--radius-2);
  text-align: center;
}

.successAlert {
  background-color: var(--color-success-3);
  border-color: var(--color-success-7);
  color: var(--color-success-11);
}

.errorAlert {
  background-color: var(--color-error-3);
  border-color: var(--color-error-7);
  color: var(--color-error-11);
}

.form {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

.field {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.helpText {
  font-family: var(--font-body);
  font-size: 0.875rem;
  color: var(--color-neutral-11);
  margin: 0;
  line-height: 1.5;
}

.submitButton {
  width: 100%;
}

.guidanceBox {
  background: var(--color-neutral-2);
  border: 1px solid var(--color-neutral-5);
  border-radius: var(--radius-2);
  padding: var(--space-4);
}

.guidanceList {
  margin: 0;
  padding-left: var(--space-5);
  color: var(--color-neutral-11);
  font-family: var(--font-body);
  font-size: 0.9rem;
  line-height: 1.6;
}

.guidanceList li {
  margin-bottom: var(--space-2);
}

.guidanceList li:last-child {
  margin-bottom: 0;
}

.comboboxTrigger {
  width: 100%;
  justify-content: space-between;
  font-weight: 400;
}

.comboboxValue {
  flex: 1;
  text-align: left;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.comboboxIcon {
  width: 16px;
  height: 16px;
  opacity: 0.5;
  flex-shrink: 0;
}

.comboboxPopover {
  width: var(--radix-popover-trigger-width);
  padding: 0;
}

.checkIcon {
  width: 16px;
  height: 16px;
  margin-right: var(--space-2);
}
